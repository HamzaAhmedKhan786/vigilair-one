APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
SITE_ID=berlin-brandenburg-demo
SITE_NAME=Brandenburg Perimeter
CAMERA_CONFIG_PATH=data/cameras.json
SCENARIO_PATH=data/scenario.json
CALIBRATION_PATH=data/calibrations.json
SITES_PATH=data/sites.json
WEATHER_ENABLED=true
EVIDENCE_DIR=data/evidence
MODEL_PROVIDER=local
DETECTOR_MODEL=yolo11n.pt
DETECTOR_DEVICE=cpu
DETECTOR_CONFIDENCE=0.35
# Point to the local organizer pack and a trusted trained ONNX file.
# CHALLENGE05_DATASET_DIR=C:/path/to/challenge-5-acoustic-visual-cuas
# ACOUSTIC_MODEL_PATH=artifacts/models/audio_wake_cnn.onnx  # or audio_wake_best.pt
# ACOUSTIC_ONNX_SHA256=<64 hex characters from your trusted model release>
# ACOUSTIC_WAKE_THRESHOLD=0.75  # required for .pt; ONNX reads metadata by default
# ACOUSTIC_ARCHITECTURE=mobilenet_v3_small  # or resnet18, matching .pt training
# RFDETR_ONNX_PATH=artifacts/models/rfdetr_nano_full.onnx
# RFDETR_ONNX_SHA256=<64 hex characters from your trusted model release>
# RFDETR_CLASS_NAMES=drone,bird  # replace with the trained model's exact class order
TRACKER_TYPE=bytetrack
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=zai-org/GLM-5.3-Flash
DATABASE_URL=sqlite:///./data/vigilair.db
DECISION_DB_PATH=data/operator_decisions.db
RETENTION_DAYS=30
AUDIO_SAMPLE_RATE=16000
AUDIO_WINDOW_MS=1000
AUDIO_NOISE_GATE_DBFS=-60
FUSION_WINDOW_SECONDS=5
ENABLE_LIVE_VIDEO=false
# Optional browser-playable video URL. If unset, the live toggle requests the laptop camera.
# VITE_LIVE_CAMERA_URL=
# Optional licensed MapLibre style URL; the fictional map uses a local blank style when unset.
# VITE_RESEARCH_BASEMAP_STYLE_URL=
# Offline research storage and fictional grid. Keep originals and weights out of Git.
RESEARCH_MODELS_PATH=models
RESEARCH_SITES_PATH=data/research_sites.json
RESEARCH_MEDIA_DB_PATH=data/research_media.db
RESEARCH_MEDIA_PATH=artifacts/media
